{
  "manifest_version": 3,
  "name": "TryAIToday Flow Automator",
  "version": "1.7.0",
  "description": "Independent prompt queue for Google Flow using its normal browser interface.",
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://flow.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TryAIToday Flow Automator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "flow-ui.js"
      ],
      "run_at": "document_idle"
    }
  ]
}