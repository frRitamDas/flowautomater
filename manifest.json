{
  "manifest_version": 3,
  "name": "FlowForge — Local Flow Assistant",
  "version": "1.7.0",
  "description": "A local-first Google Flow prompt workspace with no subscription, checkout, or extension-imposed prompt limits.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "flowforge/background.js"
  },
  "action": {
    "default_title": "Open FlowForge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "flowforge/sidepanel.html"
  }
}