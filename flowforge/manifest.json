{
  "manifest_version": 3,
  "name": "FlowForge — Local Flow Assistant",
  "version": "0.1.0",
  "description": "A local-first prompt queue for Google Flow.",
  "permissions": ["storage", "sidePanel", "tabs", "clipboardWrite"],
  "host_permissions": ["https://labs.google/*", "https://flow.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open FlowForge" },
  "side_panel": { "default_path": "sidepanel.html" }
}